# LLM: gemini | openai | mock
# Defaults to gemini if GEMINI_API_KEY is set, otherwise mock (no model, quotes the best article).
LLM_PROVIDER=gemini

# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# 0 turns thinking off. Leave empty for models that don't support it.
GEMINI_THINKING_BUDGET=0

# Any OpenAI-compatible API (Groq, OpenRouter, Ollama...). Used when LLM_PROVIDER=openai.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Postgres with pgvector. Local: docker compose up -d. Production: the Neon connection string.
# Without it the app still runs, with lexical search only and limits kept in memory.
DATABASE_URL=postgres://leyclara:leyclara@localhost:5432/leyclara

# Embeddings: gemini | openai | none (none = BM25 only)
# Run npm run ingest after changing provider or model.
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSIONS=768

# Limits
RATE_LIMIT_PER_IP_DAILY=20
RATE_LIMIT_GLOBAL_DAILY=300
MAX_QUESTION_CHARS=300
MAX_ANSWER_CHARS=900
MAX_OUTPUT_TOKENS=700
IP_HASH_SALT=change-me

# Cloudflare Turnstile. No captcha check without these.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

