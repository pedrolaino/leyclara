# ─── Modelo de lenguaje ────────────────────────────────────────────────
# gemini | openai | mock   (por defecto: gemini si hay GEMINI_API_KEY, si no mock)
# "mock" no usa IA: responde citando el artículo más relevante. Sirve para desarrollar sin key.
LLM_PROVIDER=gemini

# Google AI Studio (plan gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Presupuesto de "thinking" (0 = desactivado). Dejar vacío para modelos que no lo soportan.
GEMINI_THINKING_BUDGET=0

# Cualquier API compatible con OpenAI (Groq, OpenRouter, Ollama, etc.). Usado si LLM_PROVIDER=openai.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Embeddings ────────────────────────────────────────────────────────
# gemini | openai | none   (none = solo búsqueda léxica BM25, sin costo)
# Si se cambia el proveedor o el modelo, hay que correr `npm run index:build` de nuevo.
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSIONS=768

# ─── Protección contra abuso ───────────────────────────────────────────
RATE_LIMIT_PER_IP_DAILY=20
RATE_LIMIT_GLOBAL_DAILY=300
MAX_QUESTION_CHARS=300
MAX_ANSWER_CHARS=900
MAX_OUTPUT_TOKENS=700
IP_HASH_SALT=cambiar-por-un-valor-aleatorio

# Cloudflare Turnstile (captcha invisible, gratis). Sin estas variables no se exige captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (plan gratis): límites y caché compartidos entre instancias serverless.
# Sin estas variables se usa memoria (alcanza para desarrollo o un solo servidor).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
